<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SecAudit.Modules.DeviceForensics</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Connection-history collector reads Microsoft-Windows-Partition/Diagnostic
         and Microsoft-Windows-Kernel-PnP/Configuration via EventLogReader. -->
    <PackageReference Include="System.Diagnostics.EventLog" />
    <!-- SRUM (System Resource Usage Monitor) parser — reads SRUDB.dat (an ESE database)
         to recover per-app bytes-sent/received history over the last ~30 days. The DB is
         locked while the DPS service runs, so we snapshot it via 'esentutl /y /vss' first. -->
    <PackageReference Include="ManagedEsent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SecAudit.Plugins.Abstractions\SecAudit.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\SecAudit.Core\SecAudit.Core.csproj" />
    <ProjectReference Include="..\SecAudit.Infrastructure\SecAudit.Infrastructure.csproj" />
  </ItemGroup>
</Project>
