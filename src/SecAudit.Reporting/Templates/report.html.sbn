<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<title>BIÊN BẢN GHI NHẬN — {{ asset }}</title>
<style>
@page { size: A4; margin: 20mm 22mm; }
body { font-family: 'Times New Roman', Times, serif; margin: 0; color: #000; background:#fff; font-size: 13pt; line-height: 1.5; }

/* ===== Top header: 2 cột ===== */
.top { width: 100%; border-collapse: collapse; margin-bottom: 6px; }
.top td { vertical-align: top; padding: 0; }
/* Left ~1/3, right ~2/3 — khối phải căn giữa ở vị trí ~3/5 chiều ngang A4 đúng mẫu Công an VN */
.top .left  { width: 33%; text-align: center; }
.top .left .org-line { display: block; border-bottom: 1.5px dotted #000; height: 14pt; margin: 0 6mm 2pt 0; }
.top .left .org-line1 { display: block; font-weight: normal; font-size: 13pt; line-height: 1.3; }
.top .left .org-line2 { display: block; font-weight: bold; text-transform: uppercase; font-size: 13pt; line-height: 1.3; }
/* "Kẻ chân" — nét liền ngắn dưới khối đơn vị, đúng như Mau 1.pdf */
.top .left .org-underline { display: inline-block; border-top: 1.2px solid #000; width: 22mm; margin-top: 3pt; }
.top .right { width: 67%; text-align: center; }
.top .right .country { font-weight: bold; text-transform: uppercase; font-size: 13pt; }
/* "Độc lập" có gạch chân tích hợp với chữ (text-decoration), không dùng vạch riêng */
.top .right .motto { font-weight: bold; font-size: 13pt; text-decoration: underline; text-underline-offset: 2pt; }

.date-line { text-align: center; margin: 8pt 0 14pt 50%; font-style: italic; font-size: 12pt; white-space: nowrap; }

.title { text-align: center; font-weight: bold; font-size: 16pt; margin: 10pt 0 0 0; }
.subtitle { text-align: center; font-weight: bold; font-size: 13pt; margin: 2pt 0 14pt 0; text-decoration: underline; }

/* ===== Form blanks (real dot characters, not dotted underline) =====
   Dùng chuỗi dấu chấm thật trong nội dung HTML để cho phép người dùng in ra điền tay.
   Lý do bỏ 'border-bottom: 1px dotted': nét gạch mảnh thường không xuất hiện đẹp khi in
   Word hoặc khi PDF render qua các trình xem khác Acrobat. */
p { margin: 4pt 0; }
.indent { text-indent: 10mm; }
.section-head { font-weight: bold; font-size: 13pt; margin: 10pt 0 4pt 0; text-transform: uppercase; }
.subsection-head { font-weight: bold; font-size: 13pt; margin: 8pt 0 4pt 0; }

/* Dòng trống cả hàng để người dùng điền nhiều thông tin */
.blank-line { display: block; margin: 2pt 0; line-height: 1.6; word-break: break-all; }
/* Khối inline dạng "....." (có thể điền tay) — chỉ cần đủ chỗ ghi 2 chữ số.
   Cố ý ngắn để dòng "Hồi … giờ … ngày … tháng … năm …, tại:" KHÔNG bị xuống dòng. */
.dots-xs::before { content: "....."; }              /* ~2 chữ số: hour/min/day/month */
.dots-sm::before { content: "......."; }            /* ~4 chữ số: year */
.dots-md::before { content: "................"; }  /* ~12 ký tự: place name */
.dots-lg::before {
  content: ".................................................................................................";
}
/* Một paragraph chứa "Hồi ... giờ ... ngày ... tháng ... năm ..., tại:" cần ép một dòng */
.no-wrap { white-space: nowrap; }

/* ===== Section II tables ===== */
h3.mod-head { font-size: 13pt; font-weight: bold; margin: 10pt 0 4pt 0; }
table.data { width:100%; border-collapse:collapse; font-size:11pt; margin: 4pt 0 8pt 0; }
table.data th, table.data td { text-align:left; padding:5px 7px; border:1px solid #555; vertical-align:top; }
table.data th { background:#e9e9e9; font-weight:bold; text-align:center; }
td.sev { font-weight:bold; white-space:nowrap; text-align:center; }
td.sev-Critical { color:#b91c1c; }
td.sev-High { color:#c2410c; }
td.sev-Medium { color:#a16207; }
td.sev-Low { color:#16a34a; }
td.sev-Info { color:#444; }
.ftitle { font-weight: bold; font-size: 11pt; margin: 0 0 3pt 0; }
.evidence { font-family: 'Cascadia Mono', Consolas, monospace; font-size:10pt; white-space: pre-wrap; word-break: break-word; margin-top: 2pt; color:#333; }
.triage-box { font-size:10.5pt; line-height:1.35; }
.triage-action { font-weight:bold; }
.triage-meta { margin-top:2pt; color:#333; }
.triage-explain { margin:3pt 0; color:#111; }
.triage-steps { margin:3pt 0 0 18pt; padding:0; }
.id { font-family: 'Cascadia Mono', Consolas, monospace; font-size:10pt; white-space: nowrap; }
.kvtable th { width: 30%; background:#f3f4f6; font-weight:bold; text-align:left; }
.applied-ok { color:#15803d; font-weight:bold; }
.applied-fail { color:#b91c1c; font-weight:bold; }
.empty { font-style:italic; padding: 3pt 0; }

/* ===== Closing + signatures (2 x 2) ===== */
.closing { margin-top: 16pt; }
.signatures { margin-top: 16pt; width: 100%; border-collapse: collapse; }
.signatures td { vertical-align: top; padding: 6pt 6pt; text-align: center; font-size: 12pt; width: 50%; }
.signatures .role { font-weight: bold; text-transform: uppercase; line-height: 1.25; }
.signatures .signer-name { font-weight: bold; font-size: 12pt; margin-top: 4pt; }
.sign-space { height: 72pt; }
</style>
</head>
<body>

<!-- ============ PHẦN ĐẦU (giữ nguyên như mẫu, người dùng điền tay) ============ -->

<!-- Top header: đơn vị (meta hoặc dots) | Quốc hiệu -->
<table class="top">
  <tr>
    <td class="left">
      {{~ if meta.has_any_org_line ~}}
      {{~ if meta.has_org_line_1 ~}}<span class="org-line1">{{ meta.org_line_1 | html.escape }}</span>{{~ else ~}}<span class="org-line"></span>{{~ end ~}}
      {{~ if meta.has_org_line_2 ~}}<span class="org-line2">{{ meta.org_line_2 | html.escape }}</span>{{~ else ~}}<span class="org-line"></span>{{~ end ~}}
      <span class="org-underline"></span>
      {{~ else ~}}
      <span class="org-line"></span>
      <span class="org-line"></span>
      <span class="org-underline"></span>
      {{~ end ~}}
    </td>
    <td class="right">
      <div class="country">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
      <div class="motto">Độc lập &ndash; Tự do &ndash; Hạnh phúc</div>
    </td>
  </tr>
</table>

<p class="no-wrap" style="text-align:right; font-style:italic; font-size:12pt; margin: 4pt 0 12pt 0;">
  {{ if meta.has_place }}{{ meta.place | html.escape }}{{ else }}<span class="dots-md"></span>{{ end }}, ngày
  {{ if meta.auto_date }}{{ meta.day }}{{ else }}<span class="dots-xs"></span>{{ end }} tháng
  {{ if meta.auto_date }}{{ meta.month }}{{ else }}<span class="dots-xs"></span>{{ end }} năm
  {{ if meta.auto_date }}{{ meta.year }}{{ else }}<span class="dots-sm"></span>{{ end }}
</p>

<div class="title">BIÊN BẢN GHI NHẬN</div>
<div class="subtitle">Kết quả kiểm tra việc đảm bảo an ninh mạng, an toàn thông tin</div>

<p><b>Căn cứ kiểm tra:</b></p>
{{~ if meta.has_legal_basis ~}}
{{~ for line in meta.legal_basis_lines ~}}
<p class="indent">{{ line | html.escape }}</p>
{{~ end ~}}
{{~ else ~}}
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
{{~ end ~}}

<p class="indent no-wrap">
  Hồi {{ if meta.auto_date }}{{ meta.hour }}{{ else }}<span class="dots-xs"></span>{{ end }} giờ
  {{ if meta.auto_date }}{{ meta.minute }}{{ else }}<span class="dots-xs"></span>{{ end }} phút, ngày
  {{ if meta.auto_date }}{{ meta.day }}{{ else }}<span class="dots-xs"></span>{{ end }} tháng
  {{ if meta.auto_date }}{{ meta.month }}{{ else }}<span class="dots-xs"></span>{{ end }} năm
  {{ if meta.auto_date }}{{ meta.year }}{{ else }}<span class="dots-sm"></span>{{ end }}, tại:
</p>
{{~ if meta.has_inspection_location ~}}
{{~ for line in meta.inspection_location_lines ~}}
<p class="indent">{{ line | html.escape }}</p>
{{~ end ~}}
{{~ else ~}}
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
{{~ end ~}}

<div class="section-head">I. Thành phần</div>

<div class="subsection-head">1. Tổ kiểm tra</div>
{{~ if meta.has_inspection_team ~}}
{{~ for line in meta.inspection_team_lines ~}}
<p class="indent">{{ line | html.escape }}</p>
{{~ end ~}}
{{~ else ~}}
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
{{~ end ~}}

<div class="subsection-head">2. Đơn vị có phương tiện, thiết bị được kiểm tra:</div>
{{~ if meta.has_audited_unit_detail ~}}
{{~ for line in meta.audited_unit_detail_lines ~}}
<p class="indent">{{ line | html.escape }}</p>
{{~ end ~}}
{{~ else ~}}
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
<div class="blank-line dots-lg"></div>
{{~ end ~}}

<!-- ============ PHẦN GIỮA: II. KẾT QUẢ KIỂM TRA (dữ liệu thực) ============ -->

<div class="section-head">II. Kết quả kiểm tra</div>

<h3 class="mod-head">1. Thông tin thiết bị kiểm tra</h3>
<table class="data kvtable">
  <tr><th>Tên máy tính</th><td>{{ device.computer_name }}</td></tr>
  <tr><th>CPU</th><td>{{ device.cpu }}</td></tr>
  <tr><th>BIOS</th><td>{{ device.bios_vendor }}{{ if device.bios_version }} — phiên bản {{ device.bios_version }}{{ end }}{{ if device.bios_release_date }} (phát hành {{ device.bios_release_date }}){{ end }}</td></tr>
  <tr><th>Serial Number BIOS</th><td>{{ device.bios_serial }}</td></tr>
  <tr><th>RAM</th><td>{{ device.total_ram }}</td></tr>
  <tr><th>Hệ điều hành</th><td>{{ device.operating_system }}</td></tr>
  <tr><th>TPM / Secure Boot</th><td>TPM {{ if device.tpm_present }}có ({{ device.tpm_spec_version }}){{ else }}không{{ end }} &mdash; Secure Boot {{ if device.secure_boot }}bật{{ else }}tắt{{ end }}</td></tr>
  <tr><th>Ổ đĩa vật lý</th>
    <td>
      {{~ if device.disks.size == 0 ~}}
      <i>(không liệt kê được)</i>
      {{~ else ~}}
      {{~ for d in device.disks ~}}
      <div><b>{{ d.model }}</b> &mdash; {{ d.interface_type }} &mdash; {{ d.size }}{{ if d.serial }} &mdash; SN {{ d.serial }}{{ end }}</div>
      {{~ end ~}}
      {{~ end ~}}
    </td></tr>
  <tr><th>Địa chỉ MAC / IP</th>
    <td>
      {{~ if device.networks.size == 0 ~}}
      <i>(không phát hiện giao tiếp mạng đang hoạt động)</i>
      {{~ else ~}}
      {{~ for n in device.networks ~}}
      <div><b>{{ n.interface_name }}</b> &mdash; MAC: {{ n.mac }} &mdash; IPv4: {{ n.ipv4 }}{{ if n.ipv6 }} &mdash; IPv6: {{ n.ipv6 }}{{ end }}</div>
      {{~ end ~}}
      {{~ end ~}}
    </td></tr>
</table>

{{~ if license ~}}
<h3 class="mod-head">1b. Trạng thái bản quyền (Windows / Office)</h3>
<table class="data kvtable">
  <tr><th>Windows</th>
    <td>
      <b>{{ license.windows.product }}</b> &mdash;
      Trạng thái: <b>{{ license.windows.status_text }}</b> (mã {{ license.windows.status_code }})
      &mdash; Kênh: {{ license.windows.description }}
      {{~ if license.windows.kms_server }} &mdash; KMS: <code>{{ license.windows.kms_server }}</code>{{~ end ~}}
      {{~ if license.windows.partial_key }} &mdash; PartialKey: {{ license.windows.partial_key }}{{~ end ~}}
      &mdash; Chính hãng: <b>{{ if license.windows.is_genuine }}CÓ{{ else }}KHÔNG{{ end }}</b>
    </td></tr>
  {{~ if license.office.size == 0 ~}}
  <tr><th>Office</th><td><i>(không cài Microsoft Office)</i></td></tr>
  {{~ else ~}}
  {{~ for o in license.office ~}}
  <tr><th>Office &mdash; {{ o.product }}</th>
    <td>
      Trạng thái: <b>{{ o.status_text }}</b> (mã {{ o.status_code }})
      &mdash; Kênh: {{ o.description }}
      {{~ if o.kms_server }} &mdash; KMS: <code>{{ o.kms_server }}</code>{{~ end ~}}
      {{~ if o.partial_key }} &mdash; PartialKey: {{ o.partial_key }}{{~ end ~}}
      &mdash; Chính hãng: <b>{{ if o.is_genuine }}CÓ{{ else }}KHÔNG{{ end }}</b>
    </td></tr>
  {{~ end ~}}
  {{~ end ~}}
  {{~ if license.kmspico_suspected ~}}
  <tr><th>Cảnh báo crack / KMSpico</th>
    <td style="color:#b91c1c;">
      <b>Phát hiện dấu hiệu công cụ kích hoạt trái phép.</b>
      <ul style="margin:4pt 0 0 18pt;">
        {{~ for e in license.kmspico_evidence ~}}
        <li>{{ e }}</li>
        {{~ end ~}}
      </ul>
    </td></tr>
  {{~ end ~}}
</table>
{{~ end ~}}

{{~ if patch ~}}
<h3 class="mod-head">1c. Tổng hợp bản vá &amp; CSDL CVE</h3>
<table class="data kvtable">
  <tr><th>Số bản vá KB đã cài</th><td><b>{{ patch.installed_kb_count }}</b></td></tr>
  <tr><th>Quy tắc CVE quan trọng còn thiếu</th>
    <td>
      {{~ if patch.missing_critical == 0 ~}}
      <span style="color:#16a34a;"><b>0</b> &mdash; máy đã được vá đầy đủ theo bộ quy tắc nội bộ.</span>
      {{~ else ~}}
      <span style="color:#b91c1c;"><b>{{ patch.missing_critical }}</b> quy tắc chưa khớp KB nào — xem chi tiết ở mục Bản vá &amp; CVE phía dưới.</span>
      {{~ end ~}}
    </td></tr>
  <tr><th>CSDL CVE đồng bộ lần cuối</th>
    <td>
      {{~ if patch.cve_last_sync ~}}
      {{ patch.cve_last_sync }}
      {{~ if patch.cve_db_stale }} <span style="color:#b91c1c;">(đã quá hạn 30 ngày)</span>{{~ end ~}}
      {{~ else ~}}
      <i>chưa từng đồng bộ &mdash; chỉ áp dụng được fast-path rule nội bộ.</i>
      {{~ end ~}}
    </td></tr>
</table>
{{~ end ~}}

{{~ if scope ~}}
<h3 class="mod-head">1d. Phạm vi quét</h3>
<table class="data kvtable">
  {{~ if scope.has_autorun ~}}
  <tr><th>Mục khởi động (Run/RunOnce)</th>
    <td><b>{{ scope.autorun_suspicious }}</b> đáng ngờ / tổng <b>{{ scope.autorun_total }}</b></td></tr>
  {{~ end ~}}
  {{~ if scope.has_service ~}}
  <tr><th>Dịch vụ auto-start đáng ngờ</th><td><b>{{ scope.service_suspicious }}</b></td></tr>
  {{~ end ~}}
  {{~ if scope.has_task ~}}
  <tr><th>Scheduled task đáng ngờ</th><td><b>{{ scope.task_suspicious }}</b></td></tr>
  {{~ end ~}}
  {{~ if scope.has_wmi ~}}
  <tr><th>WMI permanent event subscription</th><td><b>{{ scope.wmi_count }}</b> (Windows sạch thường 0–2)</td></tr>
  {{~ end ~}}
  {{~ if scope.forensics_run ~}}
  <tr><th>Phiên Log Forensics</th>
    <td>
      Mã phiên: <code>{{ scope.forensics_session }}</code><br/>
      Đã phân tích <b>{{ scope.forensics_records }}</b> bản ghi từ <b>{{ scope.forensics_files }}</b> tệp;
      lưu <b>{{ scope.forensics_manifest }}</b> tệp evidence tại <code>{{ scope.forensics_root }}</code>.
    </td></tr>
  {{~ end ~}}
</table>
{{~ end ~}}

{{~ if triage.has_items ~}}
<h3 class="mod-head">1e. Hướng dẫn xử lý nhanh cho người vận hành</h3>
<table class="data kvtable">
  <tr><th>Nhóm xử lý</th>
    <td>
      {{~ for g in triage.action_groups ~}}
      <div><b>{{ g.name }}</b>: {{ g.count }} phát hiện</div>
      {{~ end ~}}
    </td></tr>
  <tr><th>Tình huống</th>
    <td>
      {{~ for s in triage.scenarios ~}}
      <div><b>{{ s.name }}</b>: {{ s.count }} phát hiện</div>
      {{~ end ~}}
    </td></tr>
  <tr><th>Cách đọc</th>
    <td>
      <div><b>Cần xử lý ngay</b>: ưu tiên lưu bằng chứng, cô lập/chặn/khắc phục.</div>
      <div><b>Cần xử lý</b>: khắc phục theo chính sách hoặc kế hoạch gần nhất.</div>
      <div><b>Cần xem lại</b>: đối chiếu baseline, người dùng và log trước khi kết luận.</div>
      <div><b>Có thể bỏ qua / Thông tin</b>: giữ để tham khảo, không coi là IOC độc hại.</div>
    </td></tr>
</table>
{{~ end ~}}

{{~ if total == 0 ~}}
<p class="empty">Không phát hiện vấn đề nào. Hệ thống đang ở trạng thái tốt.</p>
{{~ else ~}}
{{~ idx = 2 ~}}
{{~ for mod in modules ~}}
<h3 class="mod-head">{{ idx }}. {{ mod.display_name }} &mdash; {{ mod.count }} phát hiện</h3>
{{~ if mod.count == 0 ~}}
<p class="empty">Không có phát hiện nào ở module này.</p>
{{~ else ~}}
<table class="data">
<thead><tr><th>Mức độ</th><th>Mã</th><th>Tiêu đề &amp; bằng chứng</th></tr></thead>
<tbody>
{{~ for f in mod.findings ~}}
<tr>
  <td class="sev sev-{{ f.severity }}">{{ f.severity }}</td>
  <td class="id">{{ f.id }}</td>
  <td>
    <div class="ftitle">{{ f.title }}</div>
    <div class="triage-box">
      <span class="triage-action">{{ f.triage.action_group }}</span>
      <span class="triage-meta"> | Tin cậy: {{ f.triage.confidence }} | Tình huống: {{ f.triage.scenario }}</span>
      <div class="triage-explain">{{ f.triage.explanation }}</div>
      {{~ if f.triage.steps.size > 0 ~}}
      <ol class="triage-steps">
        {{~ for step in f.triage.steps ~}}
        <li>{{ step.text }}</li>
        {{~ end ~}}
      </ol>
      {{~ end ~}}
    </div>
    {{~ if f.evidence != "" ~}}
    <div class="evidence">{{ f.evidence }}</div>
    {{~ end ~}}
  </td>
</tr>
{{~ end ~}}
</tbody>
</table>
{{~ end ~}}
{{~ idx = idx + 1 ~}}
{{~ end ~}}
{{~ end ~}}

{{~ if applied.size > 0 ~}}
<h3 class="mod-head">{{ idx }}. Nội dung đã xử lý khắc phục</h3>
<table class="data">
<thead><tr><th>Mã lỗi</th><th>Hành động</th><th>Kết quả</th><th>Chi tiết</th><th>Cần khởi động lại?</th><th>Thời điểm</th></tr></thead>
<tbody>
{{~ for a in applied ~}}
<tr>
  <td class="id">{{ a.finding_id }}</td>
  <td>{{ a.title }}</td>
  <td class="{{ a.css }}">{{ a.status_text }}</td>
  <td>{{ a.message }}</td>
  <td>{{ a.reboot }}</td>
  <td>{{ a.applied_at }}</td>
</tr>
{{~ end ~}}
</tbody>
</table>
{{~ idx = idx + 1 ~}}
{{~ end ~}}

<!-- ============ PHẦN CUỐI (giữ nguyên như mẫu, người dùng điền tay) ============ -->

<p class="closing indent">
  Biên bản kết thúc hồi <span class="blank-inline w-xs"></span> giờ
  <span class="blank-inline w-xs"></span> phút cùng ngày; đã thông qua các bên cùng nhất trí và ký tên dưới đây./.
</p>

<table class="signatures">
  <tr>
    <td>
      <div class="role">Đại diện<br/>đơn vị được kiểm tra</div>
      <div class="sign-space"></div>
      {{~ if meta.audited_unit != "" ~}}<div class="signer-name">{{ meta.audited_unit | html.escape }}</div>{{~ end ~}}
    </td>
    <td>
      <div class="role">Tổ trưởng<br/>tổ kiểm tra</div>
      <div class="sign-space"></div>
      {{~ if meta.team_leader != "" ~}}<div class="signer-name">{{ meta.team_leader | html.escape }}</div>{{~ end ~}}
    </td>
  </tr>
  <tr>
    <td>
      <div class="role">Cán bộ tham gia</div>
      <div class="sign-space"></div>
      {{~ if meta.team_member != "" ~}}<div class="signer-name">{{ meta.team_member | html.escape }}</div>{{~ end ~}}
    </td>
    <td>
      <div class="role">Cán bộ lập biên bản</div>
      <div class="sign-space"></div>
      {{~ if meta.recorder != "" ~}}<div class="signer-name">{{ meta.recorder | html.escape }}</div>{{~ end ~}}
    </td>
  </tr>
</table>

</body>
</html>
