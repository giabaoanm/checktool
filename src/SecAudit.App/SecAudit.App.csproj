<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>SecAudit.App</RootNamespace>
    <AssemblyName>SecAudit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en-US;vi-VN</SatelliteResourceLanguages>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Icon cửa sổ + taskbar + file .exe. Dùng logo chính thức
         "Lực lượng An ninh mạng Sơn La" do Mr. Phương cung cấp. -->
    <ApplicationIcon>..\..\assets\icons\sonla-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecAudit.Plugins.Abstractions\SecAudit.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\SecAudit.Core\SecAudit.Core.csproj" />
    <ProjectReference Include="..\SecAudit.Infrastructure\SecAudit.Infrastructure.csproj" />
    <ProjectReference Include="..\SecAudit.Security\SecAudit.Security.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.SystemInfo\SecAudit.Modules.SystemInfo.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.Hardening\SecAudit.Modules.Hardening.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.PatchCve\SecAudit.Modules.PatchCve.csproj" />
    <ProjectReference Include="..\SecAudit.Cve.Pipeline\SecAudit.Cve.Pipeline.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.LanScanner\SecAudit.Modules.LanScanner.csproj" />
    <ProjectReference Include="..\SecAudit.Reporting\SecAudit.Reporting.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.RemoteAccess\SecAudit.Modules.RemoteAccess.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.MalwareInspector\SecAudit.Modules.MalwareInspector.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.LogForensics\SecAudit.Modules.LogForensics.csproj" />
    <ProjectReference Include="..\SecAudit.Modules.DeviceForensics\SecAudit.Modules.DeviceForensics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Logo nhúng làm WPF Resource (pack://application:,,,/Assets/sonla-logo.png).
       Link vào thư mục Assets\ để XAML tham chiếu gọn gàng dù file thật nằm
       ở ..\..\assets\icons\ để share với CLI/báo cáo nếu cần sau này. -->
  <ItemGroup>
    <Resource Include="..\..\assets\icons\sonla-logo.png" Link="Assets\sonla-logo.png" />
  </ItemGroup>
</Project>
