<Page
    x:Class="SecAudit.App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:SecAudit.App.Converters"
    Title="Dashboard">
    <Page.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: logo "Lực lượng An ninh mạng Sơn La" + tiêu đề Dashboard + đơn vị chủ quản -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Source="pack://application:,,,/Assets/sonla-logo.png"
                Width="64" Height="64"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Dashboard" />
                <ui:TextBlock
                    FontSize="12"
                    Opacity="0.75"
                    Text="Lực lượng An ninh mạng Sơn La · Son La Cyber Security Force" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Card Width="260" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                    <ui:TextBlock Text="Overall risk score" Opacity="0.7" />
                    <ui:TextBlock
                        FontSize="48"
                        FontWeight="Bold"
                        Text="{Binding OverallScore}" />
                    <ui:TextBlock Text="{Binding OverallBand}" Opacity="0.8" />
                </StackPanel>
            </ui:Card>

            <ui:Card Width="320" Padding="16">
                <StackPanel>
                    <ui:TextBlock Text="Status" Opacity="0.7" />
                    <ui:TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <ProgressBar
                        Margin="0,12,0,0"
                        Height="6"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding ProgressPercent}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <!-- Mục tiêu audit: live (máy này) hoặc một ổ Windows mount offline.
                 Bắt buộc operator chọn rõ thay vì tool tự đoán — quan trọng khi boot
                 WinPE / có nhiều ổ đĩa. -->
            <ui:Card Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Mục tiêu audit" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton
                            GroupName="AuditTarget"
                            Content="Quét máy này (live)"
                            IsChecked="{Binding IsLiveMode, Mode=TwoWay}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,0,16,0" />
                        <RadioButton
                            GroupName="AuditTarget"
                            Content="Quét ổ đĩa khác (offline)"
                            IsChecked="{Binding IsOfflineMode, Mode=TwoWay}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                    <Grid Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            IsEditable="True"
                            ItemsSource="{Binding AvailableVolumes}"
                            Text="{Binding OfflineRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Chọn ổ đĩa chứa Windows muốn audit (offline mode). Dòng có nhãn '*Windows install*' là ổ có \Windows\System32\config\SYSTEM."
                            Margin="0,0,8,0" />
                        <ui:Button
                            Grid.Column="1"
                            Content="Làm mới"
                            Appearance="Secondary"
                            Command="{Binding RefreshAvailableVolumesCommand}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>
                    <Separator Margin="0,10,0,8" />
                    <ui:TextBlock Text="Chính sách mạng" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            GroupName="PolicyProfile"
                            Content="Máy nội bộ nghiêm ngặt"
                            IsChecked="{Binding IsStrictIntranetPolicy, Mode=TwoWay}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,0,16,0" />
                        <RadioButton
                            GroupName="PolicyProfile"
                            Content="Máy dev/lab cho phép Internet"
                            IsChecked="{Binding IsInternetAllowedPolicy, Mode=TwoWay}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Content="Run Full Audit"
                    Command="{Binding RunFullAuditCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                    MinWidth="160" />
                <ui:Button
                    Margin="12,0,0,0"
                    Appearance="Secondary"
                    Content="Export Reports"
                    Command="{Binding ExportReportsCommand}"
                    MinWidth="160" />
            </StackPanel>
        </StackPanel>

        <ui:Card Grid.Row="3" Margin="0,24,0,0" Padding="0">
            <DataGrid
                ItemsSource="{Binding Findings}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="76" />
                    <DataGridTextColumn Header="Xử lý" Binding="{Binding ActionGroup}" Width="128" />
                    <DataGridTextColumn Header="Tin cậy" Binding="{Binding Confidence}" Width="96" />
                    <DataGridTextColumn Header="Tình huống" Binding="{Binding Scenario}" Width="150" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                    <DataGridTemplateColumn Header="Diễn giải / quy trình" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding OperatorGuidance}">
                                    <TextBlock
                                        Text="{Binding PlainExplanation}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Opacity="0.78"
                                        Text="{Binding OperatorStepsPreview}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" />
                    <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="120" />
                    <DataGridTemplateColumn Header="Hành động" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ui:Button
                                        Content="{Binding Action.Title}"
                                        Appearance="Primary"
                                        Padding="8,2"
                                        Command="{Binding ApplyFixCommand}"
                                        Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Text="{Binding StatusText}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding CanFix, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>
    </Grid>
</Page>
