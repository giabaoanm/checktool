<ui:FluentWindow
    x:Class="SecAudit.App.Views.Dialogs.ReportMetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Thông tin biên bản"
    Width="760" Height="780"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    MinWidth="580" MinHeight="560"
    InputMethod.IsInputMethodEnabled="True"
    InputMethod.PreferredImeState="On"
    InputMethod.PreferredImeConversionMode="Native,FullShape"
    FlowDirection="LeftToRight"
    FontFamily="Segoe UI, Times New Roman">

    <ui:FluentWindow.Resources>
        <!-- Ép IME bật cho MỌI TextBox trong dialog này (cả ui:TextBox kế thừa từ
             base TextBox). Fix: một số cấu hình Windows/WPF-UI vô hiệu hóa IME nếu
             không set rõ trên control → user không gõ được tiếng Việt Unikey/TELEX. -->
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="True" />
            <Setter Property="InputMethod.PreferredImeState" Value="On" />
            <Setter Property="InputMethod.PreferredImeConversionMode" Value="Native,FullShape" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0" Title="Thông tin biên bản" />

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24,12,24,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <ui:TextBlock
                    FontSize="13"
                    Opacity="0.75"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12"
                    Text="Mọi trường đều tùy chọn. Trường để trống sẽ được in ra thành dấu chấm để bạn điền tay sau khi in. Các giá trị sẽ được lưu lại cho lần xuất báo cáo sau." />

                <!-- ===== Header (2 dòng chuẩn biên bản Công an VN) ===== -->
                <ui:TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,6,0,4" Text="Tiêu đề biên bản (góc trên trái)" />

                <ui:TextBlock Opacity="0.7" FontSize="12" Margin="0,0,0,2"
                              Text="Dòng 1 — đơn vị cấp trên (in thường, Times New Roman 13)" />
                <ui:TextBox
                    x:Name="OrgLine1Box"
                    PlaceholderText="VD: CÔNG AN TỈNH SƠN LA"
                    Text="{Binding OrgLine1, UpdateSourceTrigger=PropertyChanged}"
                    InputMethod.IsInputMethodEnabled="True"
                    InputMethod.PreferredImeState="On"
                    FontFamily="Segoe UI"
                    Margin="0,0,0,8" />

                <ui:TextBlock Opacity="0.7" FontSize="12" Margin="0,0,0,2"
                              Text="Dòng 2 — đơn vị cấp dưới (IN HOA ĐẬM, Times New Roman 13)" />
                <ui:TextBox
                    PlaceholderText="VD: TỔ KIỂM TRA  —  hoặc  —  PHÒNG AN NINH MẠNG"
                    Text="{Binding OrgLine2, UpdateSourceTrigger=PropertyChanged}"
                    InputMethod.IsInputMethodEnabled="True"
                    InputMethod.PreferredImeState="On"
                    FontFamily="Segoe UI"
                    Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        PlaceholderText="Địa điểm (VD: Hà Nội)"
                        Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0" />
                    <CheckBox
                        Grid.Column="1"
                        Content="Tự động lấy ngày giờ hiện tại"
                        IsChecked="{Binding AutoDate}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- ===== Mở đầu ===== -->
                <ui:TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" Text="Mở đầu biên bản" />

                <ui:TextBlock Opacity="0.7" FontSize="12" Margin="0,0,0,2" Text="Căn cứ kiểm tra (mỗi căn cứ một dòng)" />
                <ui:TextBox
                    PlaceholderText="VD: Kế hoạch số.../KH-CAT ngày...&#x0A;VD: Quyết định số.../QĐ-PA05..."
                    Text="{Binding LegalBasis, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="70"
                    MaxHeight="120"
                    VerticalScrollBarVisibility="Auto"
                    Margin="0,0,0,8" />

                <ui:TextBlock Opacity="0.7" FontSize="12" Margin="0,0,0,2" Text="Địa điểm kiểm tra (tại: ...)" />
                <ui:TextBox
                    PlaceholderText="VD: Phòng máy chủ, Tầng 5, Tòa nhà A, Số 1 đường..."
                    Text="{Binding InspectionLocation, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="50"
                    MaxHeight="90"
                    Margin="0,0,0,8" />

                <!-- ===== Thành phần ===== -->
                <ui:TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" Text="I. Thành phần" />

                <ui:TextBlock Opacity="0.7" FontSize="12" Margin="0,0,0,2" Text="Tổ kiểm tra (mỗi thành viên một dòng: họ tên — chức vụ)" />
                <ui:TextBox
                    PlaceholderText="VD: Nguyễn Văn A — Tổ trưởng&#x0A;VD: Trần Thị B — Thành viên"
                    Text="{Binding InspectionTeam, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="80"
                    MaxHeight="140"
                    VerticalScrollBarVisibility="Auto"
                    Margin="0,0,0,8" />

                <ui:TextBlock Opacity="0.7" FontSize="12" Margin="0,0,0,2" Text="Đơn vị có thiết bị được kiểm tra (tên, địa chỉ, đại diện, ...)" />
                <ui:TextBox
                    PlaceholderText="VD: Công ty TNHH ...&#x0A;VD: Địa chỉ: Số ...&#x0A;VD: Đại diện: Ông/Bà ..."
                    Text="{Binding AuditedUnitDetail, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="70"
                    MaxHeight="120"
                    VerticalScrollBarVisibility="Auto"
                    Margin="0,0,0,8" />

                <!-- ===== Chữ ký ===== -->
                <ui:TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" Text="Chữ ký (4 ô)" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.7" FontSize="12" Margin="0,0,8,2" Text="Đại diện đơn vị được kiểm tra" />
                    <ui:TextBlock Grid.Row="0" Grid.Column="1" Opacity="0.7" FontSize="12" Margin="8,0,0,2" Text="Tổ trưởng tổ kiểm tra" />

                    <ui:TextBox
                        Grid.Row="1" Grid.Column="0"
                        PlaceholderText="Họ tên"
                        Text="{Binding AuditedUnit, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,8" />
                    <ui:TextBox
                        Grid.Row="1" Grid.Column="1"
                        PlaceholderText="Họ tên"
                        Text="{Binding TeamLeader, UpdateSourceTrigger=PropertyChanged}"
                        Margin="8,0,0,8" />

                    <ui:TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.7" FontSize="12" Margin="0,0,8,2" Text="Cán bộ tham gia" />
                    <ui:TextBlock Grid.Row="2" Grid.Column="1" Opacity="0.7" FontSize="12" Margin="8,0,0,2" Text="Cán bộ lập biên bản" />

                    <ui:TextBox
                        Grid.Row="3" Grid.Column="0"
                        PlaceholderText="Họ tên"
                        Text="{Binding TeamMember, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0" />
                    <ui:TextBox
                        Grid.Row="3" Grid.Column="1"
                        PlaceholderText="Họ tên"
                        Text="{Binding Recorder, UpdateSourceTrigger=PropertyChanged}"
                        Margin="8,0,0,0" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#22000000" Padding="24,12,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Appearance="Secondary"
                    Content="Để trống tất cả"
                    ToolTip="Xóa mọi trường và tắt tự động ngày giờ — báo cáo sẽ in toàn bộ dấu chấm để điền tay."
                    Command="{Binding ClearAllCommand}" />

                <ui:Button
                    Grid.Column="2"
                    Content="Hủy"
                    Margin="0,0,8,0"
                    Click="OnCancelClick" />

                <ui:Button
                    Grid.Column="3"
                    Appearance="Primary"
                    Content="Xuất báo cáo"
                    IsDefault="True"
                    Click="OnConfirmClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
