<?xml version="1.0" encoding="utf-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>LocalAdmin</Author>
    <Description>Weekly system image backup to NAS</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T02:00:00</StartBoundary>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\wbadmin.exe</Command>
      <Arguments>start backup -backupTarget:\\nas01\backup$ -include:C: -quiet</Arguments>
    </Exec>
  </Actions>
</Task>
